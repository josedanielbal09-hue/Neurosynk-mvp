# Meta Model API (Official dev.meta.ai portal)
# Powers: Muse Spark (streaming interventions), Muse Wonder (task decomposition), SAM 3.1 (workspace scan)
META_MODEL_API_KEY=your_meta_model_api_key_here
META_MODEL_API_BASE_URL=https://api.meta.ai/v1

# Baseten API (For Meta Open-Weight Fallback: muse-spark-open-1026)
BASETEN_API_KEY=your_baseten_api_key_here

# Fireworks AI (Alternative provider for Meta models)
FIREWORKS_API_KEY=your_fireworks_api_key_here

# Server Configuration
PORT=3001
NODE_ENV=development
